# PostgreSQL connection string for the optional legacy Prisma-backed routes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/substackengine?schema=public"
COOKIE_ENCRYPTION_KEY="replace-with-output-from-openssl-rand-hex-32"

# Private self-hosting only. Railway automatically enforces private mode.
# Set these as service variables, never in Git. Leave unset for local development.
# DEPLOYMENT_MODE=private
# APP_ORIGIN=https://your-service.up.railway.app
# APP_USERNAME=baekho
# APP_PASSWORD=replace-with-output-from-openssl-rand-hex-32
# SUBSTACK_DATA_DIR=/data

# Shared hosting alternative: no shared password and no server-saved rosters.
# DEPLOYMENT_MODE=shared
# APP_ORIGIN=https://your-service.up.railway.app
